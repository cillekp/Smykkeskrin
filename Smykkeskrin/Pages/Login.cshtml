@page
@model Smykkeskrin.Pages.Login

@{
    Layout = null;
    ViewData["Title"] = "Log ind";
}

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dit Digitale Smykkeskrin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        body {
            background-color: #DFD0BF;
            color: #1C1B1A;
            font-family: 'Georgia', serif;
            margin: 0;
            padding: 0;
        }

        .login-left-panel {
            background-color: #DFD0BF;
            min-height: 100vh;
        }

        .brand-header {
            color: #8C7A6B;
            font-family: sans-serif;
            font-size: 0.75rem;
            letter-spacing: 0.15em;
        }

        .underline-input {
            background-color: transparent !important;
            border: none !important;
            border-bottom: 1.5px solid #1C1B1A !important;
            border-radius: 0 !important;
            padding: 8px 0 !important;
            color: #1C1B1A !important;
            font-family: sans-serif;
            font-size: 1rem;
            box-shadow: none !important;
        }

        .underline-input:focus {
            border-bottom: 2px solid #000000 !important;
            box-shadow: none !important;
        }

        .btn-taupe {
            background-color: #9E8774;
            color: #1C1B1A;
            border: none;
            border-radius: 14px;
            padding: 13px 20px;
            font-family: sans-serif;
            font-size: 1.05rem;
            font-weight: 400;
            transition: background-color 0.2s ease;
        }

        .btn-taupe:hover {
            background-color: #8A7360;
            color: #1C1B1A;
        }

        .login-right-image {
            width: 100%;
            height: 100vh;
            object-fit: cover;
            display: block;
        }
    </style>
</head>
<body>

<div class="container-fluid p-0">
    <div class="row g-0">
        
        <div class="col-lg-5 login-left-panel d-flex flex-column justify-content-between p-5">
            
            <!-- Logo og Navn -->
            <div class="text-center pt-2">
                <img src="~/images/logo.png" alt="Dit Digitale Smykkeskrin Logo" style="width: 240px; max-width: 80%; height: auto;" />
            </div>

            <!-- Midterste formular-sektion -->
            <div class="mx-auto w-100 my-auto" style="max-width: 380px;">
                <h1 class="mb-5 fw-normal" style="font-size: 2.3rem; letter-spacing: 0.01em;">
                    Velkommen tilbage
                </h1>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger rounded-2 small py-2 mb-4" role="alert">
                        @Model.ErrorMessage
                    </div>
                }

                <form method="post">
                    <div class="mb-4">
                        <label asp-for="Username" class="form-label mb-1" style="font-family: sans-serif; font-size: 1.05rem;">Brugernavn</label>
                        <input asp-for="Username" class="form-control underline-input" />
                    </div>

                    <div class="mb-5">
                        <label asp-for="Password" class="form-label mb-1" style="font-family: sans-serif; font-size: 1.05rem;">Adgangskode</label>
                        <input asp-for="Password" type="password" class="form-control underline-input" />
                    </div>

                    <!-- Knap Log ind -->
                    <button type="submit" class="btn btn-taupe w-100 mb-3">
                        Log ind
                    </button>

                    <!-- Opret bruger knap (Sender videre til CreateUser-siden) -->
                    <a asp-page="/CreateUser" class="btn btn-taupe w-100 d-block text-center text-decoration-none">
                        Opret bruger
                    </a>
                </form>
            </div>
            
            <div></div>
        </div>

        <!-- HØJRE SIDE (60% bredde på desktop - stemningsbillede) -->
        <div class="col-lg-7 d-none d-lg-block">
            <img src="images/login.pic.png" 
                 alt="Smykkeskrin med smykker" 
                 class="login-right-image" />
        </div>

    </div>
</div>

</body>
</html>