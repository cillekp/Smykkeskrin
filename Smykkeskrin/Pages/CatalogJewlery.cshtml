@page
@model Smykkeskrin.Pages.CatalogJewlery

@{
    Layout = "_Layout";
}

<!DOCTYPE html>

<html lang="en">
<head>
    <title>Bootstrap Example</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/smykker.css" asp-append-version="true" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
  
</head>
<body>
<div class="katalog-side">
    <div class="row align-items-start">
        <!-- Venstre kolonne: Hånd bliver stående ved scroll -->
        <div class="col-md-3">
            <div class="haand-sticky">
                <img src="~/images/sketch.png" alt="sketch" class="img-fluid w-100" asp-append-version="true"/>
                <p class="mt-2 mb-0 text-center">Prøv på hånd (kommer snart)</p>
            </div>
        </div>

        <!-- Højre kolonne: Kategorimenu + 3 smykker pr. række -->
        <div class="col-md-9">
            <div class="d-flex justify-content-end gap-4 mb-4 kategori-menu">
                <a href="#">Alle</a>
                <a href="#">Ringe</a>
                <a href="#">Halskæder</a>
                <a href="#">Øreringe</a>
                <a href="#">Armbånd</a>
            </div>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="smykke-kort text-center">
                        <a href="#">
                            <img src="~/images/ring1.png" alt="SOLIS SIGNET RING" class="img-fluid w-100" asp-append-version="true"/>
                            <div class="smykke-tekst mt-2">
                                <div>SOLIS SIGNET RING</div>
                                <div>18k Guld</div>
                            </div>
                        </a>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="smykke-kort text-center">
                        <a href="#">
                            <img src="~/images/ring2.png" alt="AURA RING" class="img-fluid w-100" asp-append-version="true"/>
                            <div class="smykke-tekst mt-2">
                                <div>AURA RING</div>
                                <div>18k Guld</div>
                            </div>
                        </a>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="smykke-kort text-center">
                        <a href="#">
                            <img src="~/images/ring3.png" alt="LUNA MOON RING" class="img-fluid w-100" asp-append-version="true"/>
                            <div class="smykke-tekst mt-2">
                                <div>LUNA MOON RING</div>
                                <div>18k Guld</div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>