@page
@model Smykkeskrin.Pages.CatalogJewlery

@{
    Layout = "_Layout";
}

<!DOCTYPE html>

<html lang="en">
<head>
    <title>Bootstrap Example</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/smykker.css" asp-append-version="true" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
  
</head>



<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
    @foreach (var jewlery in Model.Jewleries) 
    {
        <div class="col">
            <div class="card h-100 rounded-0 border-0 p-3" style="background-color: #9f856e !important;">

                <!-- Billede i toppen af kortet -->
                <img src="@jewlery.ImgPth" class="card-img-top rounded-0" alt="@jewlery.Name" style="aspect-ratio: 1/1; object-fit: cover;" />

                <!-- Tekst i midten -->
                <div class="card-body text-center px-0 pt-3 pb-2">
                    <h6 class="card-title text-uppercase small fw-semibold mb-1" style="letter-spacing: 0.05em;">@jewlery.Name</h6>
                    <p class="card-text small mb-0" style="font-size: 0.8rem; opacity: 0.85;">@jewlery.Brand · @jewlery.Material</p>
                </div>

                <!-- Knap i bunden (card-footer) -->
                <div class="card-footer bg-transparent border-0 p-0 pt-2">
                    <form method="post" asp-page-handler="AddToSkrin">
                        <input type="hidden" name="jewleryId" value="@jewlery.Jewleryid" />
                        <button type="submit" class="btn btn-add-skrin w-100">
                            TILFØJ TIL SKRIN
                        </button>
                    </form>
                </div>

            </div>
        </div>
                
       
                    
    }
</div>
  