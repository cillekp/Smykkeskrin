@page
@model Smykkeskrin.Pages.CatalogJewlery

@{
    Layout = "_Layout";
}

<!DOCTYPE html>

<html lang="en">
<head>
    <title>Bootstrap Example</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/smykker.css" asp-append-version="true" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
  
</head>
<body>
<div class="katalog-side">
    
    

    <div class="pinterest-grid">
    <!-- Kolonne 1 -->
    <div class="pinterest-item smykke-kort text-center">
        <a href="#">
            <img src="~/images/ring1.png" alt="SOLIS SIGNET RING" asp-append-version="true" />
            <div class="smykke-tekst mt-2">
                <div>SOLIS SIGNET RING</div>
                <div>18k Guld</div>
            </div>
        </a>
    </div>

    <!-- Kolonne 2: Lille billede øverst -->
    <div class="pinterest-item smykke-kort text-center">
        <a href="#">
            <img src="~/images/ring2.png" alt="AURA RING" asp-append-version="true" />
            <div class="smykke-tekst mt-2">
                <div>AURA RING</div>
                <div>18k Guld</div>
            </div>
        </a>
    </div>

    <!-- Kolonne 3 -->
    <div class="pinterest-item smykke-kort text-center">
        <a href="#">
            <img src="~/images/ring3.png" alt="LUNA MOON RING" asp-append-version="true" />
            <div class="smykke-tekst mt-2">
                <div>LUNA MOON RING</div>
                <div>18k Guld</div>
            </div>
        </a>
    </div>

    <!-- Kolonne 4 -->
    <div class="pinterest-item smykke-kort text-center">
        <a href="#">
            <img src="~/images/ring1.png" alt="SMYKKE 4" asp-append-version="true" />
            <div class="smykke-tekst mt-2">
                <div>SMYKKE 4</div>
                <div>18k Guld</div>
            </div>
        </a>
    </div>

    <!-- Næste rækkes kort i fuld bredde af hver kolonne -->
    <div class="pinterest-item smykke-kort text-center">
        <a href="#">
            <img src="~/images/ring3.png" alt="LUNA MOON RING" asp-append-version="true" />
            <div class="smykke-tekst mt-2">
                <div>LUNA MOON RING</div>
                <div>18k Guld</div>
            </div>
        </a>
    </div>

    <!-- Langt billede under det lille -->
    <div class="pinterest-item smykke-kort text-center">
        <a href="#">
            <img src="~/images/ring1.png" alt="LANGT SMYKKE" class="smykke-lang" asp-append-version="true" />
            <div class="smykke-tekst mt-2">
                <div>LANGT SMYKKE</div>
                <div>18k Guld</div>
            </div>
        </a>
    </div>
</div>

</div>
</body>
</html>