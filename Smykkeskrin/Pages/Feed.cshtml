@page
@model Smykkeskrin.Pages.FeedModel
@{
    ViewData["Title"] = "Smykkeskrin Feed";
}

<div class="container mt-4">
    <h2>💍 Smykkeskrin Feed</h2>
    <p class="text-muted">Se og del opslag med vores VIP-medlemmer.</p>

    <hr />

    <!-- Formular til at oprette et nyt opslag -->
    <form method="post" class="mb-4">
        <div class="form-group">
            <label asp-for="NewDescription" class="form-label"><b>Nyt opslag i smykkeskrinet:</b></label>
            <textarea asp-for="NewDescription" class="form-control" rows="3" placeholder="Skriv hvad du har på hjertet..."></textarea>
            <span asp-validation-for="NewDescription" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary mt-2">Opret opslag</button>
    </form>

    <hr />

    <!-- Visning af alle opslag i databasen -->
    @if (Model.Feeds != null && Model.Feeds.Any())
    {
        <div class="row">
            @foreach (var feed in Model.Feeds)
            {
                <div class="col-md-12 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <p class="card-text">@feed.Description</p>
                            <div class="d-flex justify-content-between text-muted small">
                                <span>Oprettet af: <strong>@feed.UserName</strong></span>
                                <span>Oprettet: @feed.CreatedOn.ToString("dd-MM-yyyy HH:mm")</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            Der er ikke oprettet nogen opslag i feedet endnu. Vær den første til at skrive noget!
        </div>
    }
</div>